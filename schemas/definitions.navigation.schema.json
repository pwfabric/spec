{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwfabric.com/spec/schemas/definitions.navigation.schema.json",
  "title": "navigation.json",
  "description": "The app shell's links and account slot (app/definitions/navigation.json; copied to the envelope as navigation.json). Hand-written; see definitions.md.",
  "type": "object",
  "properties": {
    "navbar": {
      "type": "object",
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "href"
            ]
          }
        }
      }
    },
    "account": {
      "type": "object",
      "properties": {
        "placement": {
          "enum": [
            "navbar",
            "bottom-bar",
            "app-rail"
          ]
        },
        "profileHref": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "href"
            ]
          }
        }
      },
      "required": [
        "placement"
      ],
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "href": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "label",
                    "href"
                  ]
                }
              }
            },
            "required": [
              "heading",
              "links"
            ]
          }
        },
        "excludeSurfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
