{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwfabric.com/spec/schemas/appearance.theme.schema.json",
  "title": "Theme token set",
  "description": "The design tokens of an appearance (appearance config theme and darkTheme, a ui-appearance atom's theme). Every group and token is optional; unknown tokens are ignored. Hand-written; see appearance.md.",
  "type": "object",
  "properties": {
    "colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "card": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "textMuted": {
          "type": "string"
        },
        "border": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "success": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "textOnPrimary": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "not": {
        "required": [
          "surface"
        ],
        "description": "colors.surface is not a theme colour: the container colour is colors.card."
      }
    },
    "border": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "string"
        },
        "width": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "radiusLarge": {
          "type": "string"
        },
        "radiusSmall": {
          "type": "string"
        },
        "radiusXl": {
          "type": "string"
        },
        "radius2xl": {
          "type": "string"
        },
        "radiusFull": {
          "type": "string"
        }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "headingFontFamily": {
          "type": "string"
        },
        "monoFontFamily": {
          "type": "string"
        },
        "baseFontSize": {
          "type": "string"
        },
        "headingWeight": {
          "type": "string"
        },
        "headingLineHeight": {
          "type": "string"
        },
        "letterSpacing": {
          "type": "string"
        },
        "bodyLineHeight": {
          "type": "string"
        },
        "fontSizeSm": {
          "type": "string"
        },
        "fontSizeXs": {
          "type": "string"
        },
        "fontSizeLg": {
          "type": "string"
        },
        "fontSizeXl": {
          "type": "string"
        },
        "fontSize2xl": {
          "type": "string"
        },
        "fontSize3xl": {
          "type": "string"
        },
        "fontSize4xl": {
          "type": "string"
        },
        "bodyWeight": {
          "type": "string"
        },
        "bodyLetterSpacing": {
          "type": "string"
        },
        "fontSizeH1": {
          "type": "string"
        },
        "fontSizeH2": {
          "type": "string"
        },
        "fontSizeH3": {
          "type": "string"
        },
        "fontSizeH4": {
          "type": "string"
        },
        "fontSizeH5": {
          "type": "string"
        }
      }
    },
    "spacing": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        },
        "xs": {
          "type": "string"
        },
        "sm": {
          "type": "string"
        },
        "md": {
          "type": "string"
        },
        "lg": {
          "type": "string"
        },
        "xl": {
          "type": "string"
        },
        "xxl": {
          "type": "string"
        }
      }
    },
    "shadows": {
      "type": "object",
      "properties": {
        "card": {
          "type": "string"
        },
        "button": {
          "type": "string"
        },
        "sm": {
          "type": "string"
        },
        "md": {
          "type": "string"
        },
        "lg": {
          "type": "string"
        },
        "xl": {
          "type": "string"
        }
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "durationFast": {
          "type": "string"
        },
        "durationNormal": {
          "type": "string"
        },
        "durationSlow": {
          "type": "string"
        },
        "easing": {
          "type": "string"
        },
        "easingBounce": {
          "type": "string"
        }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "gap": {
          "type": "string"
        },
        "padding": {
          "type": "string"
        },
        "containerMaxWidth": {
          "type": "string"
        },
        "gridGap": {
          "type": "string"
        },
        "sectionPaddingY": {
          "type": "string"
        },
        "sectionPaddingX": {
          "type": "string"
        }
      }
    },
    "focus": {
      "type": "object",
      "properties": {
        "ringColor": {
          "type": "string"
        },
        "ringWidth": {
          "type": "string"
        },
        "ringOffset": {
          "type": "string"
        }
      }
    },
    "zIndex": {
      "type": "object",
      "properties": {
        "sticky": {
          "type": "integer"
        },
        "nav": {
          "type": "integer"
        },
        "dropdown": {
          "type": "integer"
        },
        "drawer": {
          "type": "integer"
        },
        "modal": {
          "type": "integer"
        },
        "toast": {
          "type": "integer"
        }
      }
    },
    "fonts": {
      "description": "The app's own font files, by family (appearance.md §3.3): each file an app media path media/fonts/<file>.woff2. The format knows no font service.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "description": "The family name the typography tokens use.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\"';{}<>\\\\,]+$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "description": "The file, from the pack root: media/fonts/<file>.woff2.",
                  "type": "string",
                  "pattern": "^media/fonts/(?!\\.)[A-Za-z0-9._-]+\\.woff2$"
                },
                "weight": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    {
                      "type": "string",
                      "pattern": "^(?:1000|[1-9][0-9]{0,2}) (?:1000|[1-9][0-9]{0,2})$"
                    }
                  ],
                  "description": "A CSS weight from 1 to 1000, or a variable font's range \"200 800\", written low to high."
                },
                "style": {
                  "enum": [
                    "normal",
                    "italic"
                  ]
                },
                "unicodeRange": {
                  "description": "The code points the file covers, as CSS unicode-range writes them.",
                  "type": "string",
                  "pattern": "^U\\+[0-9A-Fa-f?]{1,6}(?:-[0-9A-Fa-f]{1,6})?(?:, ?U\\+[0-9A-Fa-f?]{1,6}(?:-[0-9A-Fa-f]{1,6})?)*$"
                }
              },
              "required": [
                "src",
                "weight"
              ],
              "additionalProperties": false
            }
          },
          "fallback": {
            "description": "The generic family drawn until the file arrives and when it cannot be had.",
            "enum": [
              "serif",
              "sans-serif",
              "monospace",
              "cursive",
              "fantasy",
              "system-ui",
              "ui-serif",
              "ui-sans-serif",
              "ui-monospace",
              "ui-rounded",
              "math",
              "emoji"
            ]
          }
        },
        "required": [
          "family",
          "files"
        ],
        "additionalProperties": false
      }
    }
  }
}
