{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwfabric.com/spec/schemas/session-protocol.schema.json",
  "title": "Door response",
  "description": "What a session server answers to sign-in, registration, the session read and the gateway session read: a token, its expiry and optionally the principal. A refusal is { error: { code, message } }. Hand-written; see session-protocol.md.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            },
            "expiresAt": {
              "type": "string"
            },
            "principal": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "email": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "displayName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "avatarUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "token"
              ]
            },
            {
              "required": [
                "principal"
              ]
            }
          ]
        }
      },
      "required": [
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "required": [
        "error"
      ]
    }
  ]
}
