{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwfabric.com/spec/schemas/definitions.auth.schema.json",
  "title": "app/definitions/auth.json",
  "description": "Who may enter the app: the identity declaration, optionally with access roles and rules. Generated from the reference schema ProjectIdentitySchema (+ topology rules, + access); do not edit by hand.",
  "type": "object",
  "properties": {
    "required": {
      "type": "boolean",
      "default": false
    },
    "topology": {
      "type": "string",
      "enum": [
        "app",
        "external"
      ],
      "default": "app"
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "password",
          "phiwebs",
          "google",
          "github",
          "microsoft"
        ]
      },
      "default": []
    },
    "connections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "enum": [
              "shared",
              "own"
            ],
            "default": "shared"
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tenant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "enum": [
          "google",
          "github",
          "microsoft"
        ]
      },
      "default": {}
    },
    "issuer": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "default": [
            "openid",
            "profile",
            "email"
          ]
        },
        "audience": {
          "type": "string",
          "maxLength": 500
        },
        "authorizeUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        },
        "tokenUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        },
        "jwksUri": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        }
      },
      "required": [
        "issuer",
        "clientId"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "default": "sub"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "default": "email"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "default": "name"
        },
        "roles": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "additionalProperties": false,
      "default": {
        "subject": "sub",
        "email": "email",
        "name": "name"
      }
    },
    "access": {
      "description": "Optional roles and row rules that travel beside the identity. Not part of the identity itself; a reader removes it before validating the identity.",
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "subject",
              "model",
              "rule"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "topology": {
            "const": "external"
          }
        },
        "required": [
          "topology"
        ]
      },
      "then": {
        "required": [
          "issuer"
        ],
        "properties": {
          "methods": {
            "maxItems": 0
          },
          "connections": {
            "maxProperties": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "issuer"
          ]
        }
      }
    }
  ]
}
