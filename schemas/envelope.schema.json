{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwfabric.com/spec/schemas/envelope.schema.json",
  "title": "project.json",
  "description": "The entry document of an app envelope: its pages, their receipt files and the identity it requires. Hand-written; see envelope.md.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": [
        "string",
        "number"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "description": "The app's locale, a BCP 47 tag (en-GB): dates and numbers are written in it, and it is the shell's <html lang>.",
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "description": "The app's words: message id -> string, in its locale (envelope.md §2.1).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entrySurfaceId": {
      "type": "string",
      "minLength": 1
    },
    "surfaceOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "surfaceReceiptFiles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "notFoundSurfaceId": {
      "description": "Key of the app's own not-found page; its receipt is in surfaceReceiptFiles, and it is not in surfaceOrder.",
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "topology": {
          "enum": [
            "app",
            "external"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "door": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ]
    }
  },
  "required": [
    "entrySurfaceId",
    "surfaceOrder"
  ]
}
