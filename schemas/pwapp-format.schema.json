{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwfabric.com/spec/schemas/pwapp-format.schema.json",
  "title": "publish.json",
  "description": "The resolution record a published app (.pwapp) carries beside its .pwpack: the exact pack builds, atom hashes and media addresses it was published with. Provisional shape (status draft). Hand-written; see pwapp-format.md.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "description": "The app (pwpack.json id and version) this record publishes."
    },
    "liveVersion": {
      "type": "string",
      "minLength": 1,
      "description": "The published version visitors are served."
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "hash"
        ]
      },
      "description": "Resolved pins: every pack build the app runs on."
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "Path of the compiled module, relative to the published folder."
          },
          "integrity": {
            "type": "string",
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "pattern": "^sha256-[A-Za-z0-9+/]+={0,2}$"
              }
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "hash"
        ]
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "url"
        ]
      }
    },
    "csp": {
      "type": "object",
      "description": "The app's Content Security Policy (pwapp-format §2.1): the header value a host serves, and the origins the producer could not resolve.",
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "value"
            ]
          }
        }
      },
      "required": [
        "policy"
      ]
    },
    "headers": {
      "description": "The app's own header rules, from app/plan.json headers: a host that does not read _headers applies them after the engine's (pwapp-format.md §2.6).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "The paths the rule applies to, root-relative to the app; * matches any run of characters.",
            "type": "string",
            "pattern": "^/[^\\s]*$"
          },
          "headers": {
            "description": "Header name -> value. A name is an HTTP token; Content-Security-Policy is the engine's and cannot be set.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9#$%&'*+.^_`|~-]+$",
              "not": {
                "pattern": "^[Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Ss][Ee][Cc][Uu][Rr][Ii][Tt][Yy]-[Pp][Oo][Ll][Ii][Cc][Yy]$"
              }
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]*$"
            }
          }
        },
        "required": [
          "path",
          "headers"
        ],
        "additionalProperties": false
      }
    },
    "redirects": {
      "description": "The app's redirects, from app/plan.json redirects, in order (pwapp-format.md §2.6).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "description": "The path redirected, root-relative to the app; a trailing * matches the rest of the path.",
            "type": "string",
            "pattern": "^/[^\\s*]*\\*?$"
          },
          "to": {
            "description": "Where to: a root-relative path (:splat stands for what the * matched) or an absolute http(s) URL.",
            "type": "string",
            "pattern": "^(?:/[^\\s]*|https?://[^\\s/?#]+(?:[/?#][^\\s]*)?)$"
          },
          "status": {
            "description": "The redirect status; default 301.",
            "enum": [
              301,
              302,
              307,
              308
            ]
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "app",
    "packs"
  ]
}
