{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwfabric.com/spec/schemas/definitions.entities.schema.json",
  "title": "entities.json",
  "description": "The data models (entity types) the app declares (app/definitions/entities.json). Hand-written; see definitions.md.",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "typeId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "description": "text, number, boolean, date, relation or enum (definitions.md, Field types). Other values are carried unchecked.",
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "targetTypeId": {
                  "description": "relation only: the typeId of the entity the field points at.",
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "description": "enum only: the values the field may hold.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "server": {
                  "description": "A server-owned field (definitions.md, Server-owned fields): the server sets it, and refuses a client value for it.",
                  "anyOf": [
                    {
                      "enum": [
                        "owner",
                        "createdAt",
                        "updatedAt"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "default": {}
                      },
                      "required": [
                        "default"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "name",
                "type"
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "targetTypeId"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "relation"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "enum"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "values"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "values"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "enum"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "typeId"
        ]
      }
    }
  }
}
