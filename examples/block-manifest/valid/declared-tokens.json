{
  "id": "layout.sidebar",
  "kind": "block",
  "version": "1.0.0",
  "category": "layout",
  "name": "sidebar",
  "state": "stable",
  "knowledge": {
    "purpose": "The app's top bar: brand, page links and a menu toggle on narrow screens",
    "useCases": [
      "The top of every page, in the layout"
    ],
    "composesWith": [
      "control.language-switch"
    ],
    "antiPatterns": [
      "A second navbar on a page that has one in the layout"
    ]
  },
  "definition": {
    "props": [
      {
        "name": "logoText",
        "type": "string",
        "copy": true
      },
      {
        "name": "navLabel",
        "type": "string",
        "copy": true
      },
      {
        "name": "copyButton",
        "type": "boolean",
        "default": false
      }
    ],
    "defaultProps": {},
    "canHaveChildren": true,
    "tokens": [
      {
        "name": "rowGap",
        "type": "length",
        "default": "2px",
        "description": "Space between two rows of the tree."
      },
      {
        "name": "currentInk",
        "type": "color",
        "default": "var(--pw-color-text)",
        "description": "Ink of the link to the page in view."
      },
      {
        "name": "groupWeight",
        "type": "fontWeight",
        "default": "600",
        "description": "Weight of a group label."
      },
      {
        "name": "lineHeight",
        "type": "lineHeight",
        "default": "20px",
        "description": "Line height of a row."
      }
    ]
  }
}
